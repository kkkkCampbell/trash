EOF
    
	
    # Добавляем новую опцию со стратегией
	# echo "$STRAT"
    echo "$STRAT" | tr ' ' '\n' >> "$TMPFILE"
	echo "'
	">> "$TMPFILE"
	
    # Заменяем оригинальный файл
	> /etc/config/zapret
    mv "$TMPFILE" /etc/config/zapret >/dev/null 2>&1
	cd /opt/zapret/
	sh sync_config.sh
    # echo "Конфигурация обновлена"

	# Запускаем синхронизацию конфигов (вот додумались блин)
	echo "Запускаю синхронизацию конфигов"
	sh sync_config.sh

    # Запускаем zapret
    printf "Запускаю zapret... "
    service zapret restart >/dev/null 2>&1

    if ! /etc/init.d/zapret status >/dev/null 2>&1; then
        echo "Предупреждение: zapret не запустился автоматически"
    fi

} # strat_replace end

# Аргументы: имя файла, в котором надо подсчитать количество строк
strategy_counter() {

	local FILE="$1"
	# Подсчет количества строк в файле
	if [ ! -f "$FILE" ]; then
		#echo "Файл $FILE не найден"
		echo "0"
	else
		wc -l <"$FILE"
	fi
}

# Функция подбора стратегий
strategy_scan() {

	# Останавливаем youtubeUnblock
	echo "Останавливаем youtubeUnblock"
	service youtubeUnblock stop >/dev/null 2>&1
	service youtubeUnblock disable >/dev/null 2>&1

	# Останавливаем zapret
	echo "Останавливаем zapret"
	/etc/init.d/zapret stop >/dev/null 2>&1
	sleep 1
	killall nfqws >/dev/null 2>&1

    # Запускаем поиск стратегий
    export MAX_QUICK_STRATEGIES
	echo "Ищем стратегий: $MAX_QUICK_STRATEGIES"
    $BLOCKCHECK_SH 2>&1 | tee /tmp/resscan/raw.txt
	rm /tmp/resscan/final.txt >/dev/null 2>&1

    # Извлекаем стратегию
    awk 'p; /^\* SUMMARY/{p=1; next}' /tmp/resscan/raw.txt | sed -n 's/.* : nfqws //p' > /tmp/resscan/final.txt

    if [ ! -s "/tmp/resscan/final.txt" ]; then
        echo "Ошибка: не удалось извлечь стратегию"
        exit 1
	else
		mv /tmp/resscan/final.txt "$FINDED_STRATEGY"
    fi
	
	# Запускаем zapret
	/etc/init.d/zapret start >/dev/null 2>&1
	
}

