		echo
		printf "Введите номер пункта меню > "
		read -r idx
		case $idx in
			00)
				echo; echo "Удаляемсу, нащяяяльникамана..."
				FULLDELETE=1
				delete_me
				echo
				echo
				echo "КОНЕЦ"
				echo
				echo				
				exit 0
				;;
			0)
				service zapret restart >/dev/null 2>&1
				exit 0
				;;
			1)  
				# FILE=""
				# rm "$FINDED_STRATEGY" >/dev/null 2>&1
				strategy_scan
				uci set firewall.@defaults[0].flow_offloading=''
				uci set firewall.@defaults[0].flow_offloading_hw='1'
				uci commit firewall
				service firewall restart
				# # Перезапускаем сами себя
				# sh "$SCRIPT_PATH_NAME" &
				# exit
				;;
			2) 	
				STRAT_COUNT=$(strategy_counter "$FINDED_STRATEGY")
				if [ $STRAT_COUNT -gt 0 ]; then
					FILE="$FINDED_STRATEGY"
					break
				echo "Файл "$FINDED_STRATEGY" с найденными стратегиями отсутствует, или пуст."
				fi
				;;
			3)
				# Перебор предустановленных стратегий
				STRAT_COUNT=$(strategy_counter "$PRESET_STRATEGY")
				if [ $STRAT_COUNT -gt 0 ]; then
					FILE="$PRESET_STRATEGY"
					break
				echo "Файл "$PRESET_STRATEGY" с предустановленными стратегиями отсутствует, или пуст."
				fi
				
				;;
			4) 
				# Сколько стратегий найти
				printf "Новое количество рабочих стратегий = "
				read -r idx
				case $idx in ''|*[!0-9]*) echo "";; *) MAX_QUICK_STRATEGIES="$idx";; esac
				;;
			335) 
				FULLDELETE=0
				delete_me
				exit 0
				;;
			*)
				echo "Некорректный ввод. Повторите попытку."
				sleep 1
				;;
		esac
	done

	# Если файл пустой
	if [ "$STRAT_COUNT" -eq 0 ]; then
		echo "Файл $FILE пуст"
		exit 1
	fi

	# Цикл проверки стратегий
	foo=0
	echo
	echo -e "${RED}!!!_${YELLOW}ВНИМАНИЕ${RED}_!!!${NC}"
	echo -e "${RED}!!!_${YELLOW}ВНИМАНИЕ${RED}_!!!${NC}"
	echo -e "${RED}!!!_${YELLOW}ВНИМАНИЕ${RED}_!!!${NC}"
	echo
	echo -e "${YELLOW}Проверка стратегий автоматически заменяет конфигурацию zapret. Сделайте архивную копию!${NC}"
	printf "Запустить проверку стратегий? 1 - Да. 0 - Нет. > "
	read foo
	if [ -z "$foo" ] || [ "$foo" -ne 1 ]; then
	  exit 1
	fi
	
	i=1
	while [ "$i" -le "$STRAT_COUNT" ]; do
		# Чтение строки по номеру
		STRAT=$(sed -n "${i}p" "$FILE")
		
		# Удаляем лишние пробелы
		STRAT=$(echo "$STRAT" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
		
		if [ -z "$STRAT" ]; then
			echo "Строка $i пуста, пропускаем..."
			i=$((i + 1))
			continue
		fi
		
		echo
		echo " Применяем стратегию $i из $STRAT_COUNT"
		[ "$STRAT_COUNT" -gt 9 ] && printf "="
		echo "============================"
		# echo -e "${GREEN}$STRAT${NC}"
		
		# Применяем стратегию
		strat_replace "$STRAT"
		sleep 1
		
		# Перезапускаем запрет
		# service zapret restart >/dev/null

		# Тестируем подключение к ютубу		
		TLS12=0; TLS13=0
		if curl --tlsv1.2 --max-time $CHECK_TIMEOUT --user-agent  "$USER_AGENT" -s -o /dev/null "$TEST_URL" >/dev/null 2>&1; then 
			printf "\033[32m1.2✓ \033[0m "
			TLS12=1
		else 
			printf "\033[31m1.2✗ \033[0m"
		fi
		
 		if curl --tlsv1.3 --max-time $CHECK_TIMEOUT --user-agent "$USER_AGENT" -s -o /dev/null "$TEST_URL" >/dev/null 2>&1; then
			printf "\033[32m1.3✓ \033[0m "
			TLS13=1
		else
			printf "\033[31m1.3✗ \033[0m"; 
		fi
		
		case $((TLS12 + TLS13)) in
			0)
				printf "Нерабочая стратегия." 
				;;
			1) 
				printf "${YELLOW}Частично рабочая стратегия.${NC}" 
				;;
			2)
				echo -e "${GREEN}НАЙДЕНА ПОЛНОСТЬЮ РАБОЧАЯ СТРАТЕГИЯ!${NC}"
				# echo "$STRAT" > /etc/zapret_autoconfig/zapret_success_strategy.txt
				echo "Проверяйте доступ к Ютуб."
				printf "Всё нормально - 1. Не пашет - Enter. > "
				read -r answer
				case $answer in 1) break ;; *) echo "Продолжение тестирования" ;; esac
				;;
		esac
		i=$((i + 1))
	done
done
