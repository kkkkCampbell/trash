SCRIPT_PATH_NAME="$(dirname "$0")/$(basename "$0")"
SCRIPT_PATH_NAME="${SCRIPT_PATH_NAME//\/\//\/}"
FULLDELETE=0

cd 

# Выводится при каждой инсталляции при условии ранее проведённой корректной деинсталляции
# Если скрипт не установлен ранее, то...
if [ ! -f "$ZAPRET_BASE_DIR/already_installed" ]; then

	mkdir -p /etc/zapret_autoconfig/backup
	
	# Собираем информацию о состоянии сервисов на момент первого запуска.
	echo "#!/bin/ash
	" > /etc/zapret_autoconfig/restore_services_state.sh
	
	# Если запрет установлен, формируем команду на переустановку
	if opkg list-installed zapret | grep -q zapret > /dev/null 2>&1; then
		echo "
		echo Переустанавливаем zapret.
		echo
		opkg update
		echo
		opkg install --force-reinstall --force-maintainer zapret luci-app-zapret
		echo
		echo Запрет, вроде, переустановлен.
		echo
		echo" >> /etc/zapret_autoconfig/restore_services_state.sh
	else 
		# Если запрет не установлен, формируем команду на удаление
		echo "
		opkg remove --force-removal-of-dependent-packages zapret luci-app-zapret zapret" >> /etc/zapret_autoconfig/restore_services_state.sh	
	fi

	# Проверяем каждый сервис
	for serv in zapret ruantiblock youtubeUnblock podkop sing-box; do
		if /etc/init.d/"$serv" running > /dev/null 2>&1; then
			echo "service $serv start" >> /etc/zapret_autoconfig/restore_services_state.sh
		else
			echo "service $serv stop" >> /etc/zapret_autoconfig/restore_services_state.sh
		fi
		
		if /etc/init.d/"$serv" enabled >/dev/null 2>&1; then
				echo "service $serv enable" >> /etc/zapret_autoconfig/restore_services_state.sh
			else
				echo "service $serv disable" >> /etc/zapret_autoconfig/restore_services_state.sh
		fi
	done

	# Проверяем sing-box и если запущен, добавляем команды для podkop
	if /etc/init.d/sing-box running >/dev/null 2>&1; then
		echo "service podkop restart" >> /etc/zapret_autoconfig/restore_services_state.sh
		echo "service podkop enable" >> /etc/zapret_autoconfig/restore_services_state.sh
	fi	

	# Делаем архивную копию конфига запрета
	clear
	echo
	tempname="/etc/zapret_autoconfig/backup/config_zapret_$(date +'%Y-%m-%d_%H-%M-%S')"

	cp -f /etc/config/zapret "$tempname"
	echo "$tempname" >/etc/zapret_autoconfig/uninstall

	echo "Архивная копия конфигурации запрета сохранена в"
	echo
	echo -e "${YELLOW}$tempname${NC}"
	echo
	echo "При корректном удалении (по 00) будет восстановлена именно она."
	echo -e "
В директории ${YELLOW}/etc/zapret_autoconfig/backup/${NC} хранятся ВСЕ архивные копии конфигурации zapret, созданные при каждой ИНСТАЛЛЯЦИИ скрипта.
Вы можете их восстановить самостоятельно при необходимости."
	echo "
САМОЕ ВРЕМЯ СОЗДАТЬ АРХИВНУЮ КОПИЮ НАСТРОЕК РОУТЕРА!"
	echo
	echo -e "${GREEN}Для продолжения установки нажмите любую клавишу...${NC}"
	read foo
	printf "${YELLOW}АРХИВНАЯ КОПИЯ НАСТРОЕК РОУТЕРА СОЗДАНА? Y - Да. N - Нет. >${NC}"
	read foo
	case "$foo" in
	  [Nn]) exit 0 ;;
	esac
fi


# Останавливаем youtubeUnblock
echo "Останавливаем youtubeUnblock"
service youtubeUnblock stop >/dev/null 2>&1
service youtubeUnblock disable >/dev/null 2>&1

clear

echo $VERSION


