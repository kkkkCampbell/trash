#!/bin/sh
# Ютуб в подкоп
# u_to_podkop

# Цвета текста
RED='\033[0;31m'       # Красный
GREEN='\033[0;32m'     # Зеленый
YELLOW='\033[0;33m'    # Желтый
BLUE='\033[0;34m'      # Синий
MAGENTA='\033[0;35m'   # Magenta
CYAN='\033[0;36m'      # Циан
WHITE='\033[0;37m'     # Белый

# Сброс цвета
RESET='\033[0m'

main() {

	clear
	echo "Ютуб в подкоп v0.3.0"

	TARGET_DOMAIN="ya.ru"
	PACKET_COUNT=4 
	PING_TIMEOUT=5
	PACKAGE="podkop"
	PODKOP_VERSION=""

	# Проверяем наличие подкопа в системе и его версию
	# Получаем версию установленного пакета (пусто если не установлен)
	PODKOP_VERSION=$(opkg list-installed | grep "^$PACKAGE " | awk '{print $3}')
	# Выделяем мажорную версию
	PODKOP_VERSION=$(echo "$PODKOP_VERSION" | cut -d '.' -f 1-2)

	if [ -z "$PODKOP_VERSION" ]; then
		echo -e "\033[33m
		PODKOP НЕ УСТАНОВЛЕН!
		УСТАНОВИТЕ СКРИПТ ИЗ ЗАКРЕПА \"ИНТЕРНЕТ БЕЗ ГРАНИЦ\" - https://t.me/routerich/3845\033[0m"
		exit 1
	fi

	if [ -n "$PODKOP_VERSION" ] && echo "$PODKOP_VERSION" | grep -q -E "v0\.[67]"; then
		echo -e "\033[32mВерсия пакета $PACKAGE: "$PODKOP_VERSION"\033[0m"
	else
		echo -e "\033[33mУстановленная версия пакета $PACKAGE ($PODKOP_VERSION) устарела\033[0m"
		echo -e "\033[33mРекомендуется обновить $PACKAGE до версии v0.7\033[0m"
		exit 1
	fi

	echo

	# Останавливаем сервисы
	SERVICES_STOP="youtubeUnblock zapret"
	SERVICES_START="opera-proxy dnsmasq odhcpd podkop"
	echo "Останавливаем сервисы: $SERVICES_STOP"
	
	for service in $SERVICES_STOP; do
	  service $service stop >/dev/null 2>&1
	  service $service disable >/dev/null 2>&1
	done

	# Получаем имена секций из конфига подкопа, проверяем работоспособность интерфейсов итп.
	# 1. ПОДГОТОВКА ИМЁН СЕКЦИЙ
	if [ "$PODKOP_VERSION" = "v0.6" ]; then STRING_TO_FIND="=extra"; fi
	if [ "$PODKOP_VERSION" = "v0.7" ]; then STRING_TO_FIND="=section"; fi		
	SECTIONS_LIST=$(uci show podkop | grep "${STRING_TO_FIND}" | cut -d '.' -f 2 | cut -d '=' -f 1)
	if [ "$PODKOP_VERSION" = "v0.6" ]; then SECTIONS_LIST=$(printf "main\n%s" "$SECTIONS_LIST"); fi
	SECTION_COUNT=$(echo "$SECTIONS_LIST" | wc -l)
	FIRST_SECTION_NAME=$(echo "$SECTIONS_LIST" | head -n 1)
	SECOND_SECTION_NAME=$(echo "$SECTIONS_LIST" | sed -n '2p')

	# 2. КРИТИЧЕСКАЯ ПРОВЕРКА И УСЛОВИЕ ОДНОЙ СЕКЦИИ
	if [ "$SECTION_COUNT" -lt 1 ]; then
		echo "Критическая ошибка: В конфигурации 'podkop' не найдено ни одной секции."
		services_restart
		exit 1		
	fi

	# Если есть хотя бы одна секция, удаляем из неё community_list 'youtube'
	for SECTION_NAME in $SECTIONS_LIST; do
		uci del_list podkop."$SECTION_NAME".community_lists='youtube'
		# Если в этой секции 'youtube' был единственным community_list
		# отключаем листы сообщества в жопу (да, я задолбался!)
		COMMUNITY_LIST="$(uci -q get podkop."$SECTION_NAME".community_lists)"
		# Проверяем, является ли значение пустой строкой.
		if [ -z "$COMMUNITY_LIST" ]; then
			# echo "Секция $SECTION_NAME: community_lists пуст. Установка community_lists_enabled='0'"
			uci set podkop."$SECTION_NAME".community_lists_enabled='0'
		fi
	
	done
	uci commit podkop
	sleep 3
	
	if [ "$SECTION_COUNT" -eq 1 ]; then
		echo "В настройках podkop обнаружена только одна секция: $FIRST_SECTION_NAME"
		echo "-> Добавляем youtube в секцию $FIRST_SECTION_NAME"
		uci add_list podkop."$FIRST_SECTION_NAME".community_lists='youtube'
		uci set podkop."$FIRST_SECTION_NAME".community_lists_enabled='1'
		services_restart		
		exit 0	
	fi

	# 3. ПОЛУЧЕНИЕ ИНТЕРФЕЙСА (Интерфейс берется только из второй секции)
	INTERFACE_NAME=$(uci -q get podkop."$SECOND_SECTION_NAME".interface)
	SHOULD_WRITE_TO_SECOND=0

	# === 4. УСЛОВИЕ ПРОВЕРКИ: Интерфейс задан? ===
	if [ -n "$INTERFACE_NAME" ]; then
		echo "Выполняем проверку ping ($INTERFACE_NAME)..."
		# ping с таймаутом и привязкой к интерфейсу
		ping -c "$PACKET_COUNT" -W "$PING_TIMEOUT" -I "$INTERFACE_NAME" "$TARGET_DOMAIN" >/dev/null 2>&1
		CHECK_RESULT=$?
		if [ "$CHECK_RESULT" -eq 0 ]; then
			echo "Ping прошел успешно"
			SHOULD_WRITE_TO_SECOND=1
		else
			echo "Ping не прошел. (Код: $CHECK_RESULT)"
			# SHOULD_WRITE_TO_SECOND остается 0 (логика провала)
		fi
	fi

	# Если INTERFACE_NAME пуст, то SHOULD_WRITE_TO_SECOND остается 0 (логика провала)
	# === 5. ФИНАЛЬНОЕ ДЕЙСТВИЕ ===
	if [ "$SHOULD_WRITE_TO_SECOND" -eq 1 ]; then
		# УСПЕХ: пишем во вторую секцию
		uci add_list podkop."$SECOND_SECTION_NAME".community_lists='youtube'
		uci set podkop."$SECOND_SECTION_NAME".community_lists_enabled='1'
		echo "-> Добавляем youtube в секцию $SECOND_SECTION_NAME"
	else
		# ПРОВАЛ (любой случай: нет интерфейса, пинг провален): пишем в первую секцию
		uci add_list podkop."$FIRST_SECTION_NAME".community_lists='youtube'
		uci set podkop."$FIRST_SECTION_NAME".community_lists_enabled='1'
		echo "-> Добавляем youtube в секцию $FIRST_SECTION_NAME"
	fi

	services_restart

}

	services_restart() {
	uci commit podkop
	uci commit
	echo "Перезапускаем сервисы"
	for service in $SERVICES_START; do
	  service $service restart >/dev/null 2>&1; echo "  $service"
	  service $service enable >/dev/null 2>&1
	done
	sleep 2; service podkop restart >/dev/null 2>&1

	echo "-----------------------------------"
	echo -e "${GREEN}Настройка окончена. Конфигурация обновлена.

!!!_ЗАКРОЙТЕ БРАУЗЕР_!!!
Откройте его вновь и ТОЛЬКО ТЕПЕРЬ проверяйте доступ к Ютуб.
${RESET}
"
	}
	
main
exit 0

echo "РОУТЕР ПЕРЕЗАГРУЗИТСЯ ЧЕРЕЗ 10 СЕКУНД!"
sleep 10
reboot


# Ютуб в подкоп
# u_to_podkop
